{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.1.1",
  "id": "{{APP_ID}}",
  "developer": {
    "name": "Rod Trent",
    "websiteUrl": "https://github.com/rod-trent/mic-check",
    "privacyUrl": "{{CONTENT_BASE}}/privacy.html",
    "termsOfUseUrl": "{{CONTENT_BASE}}/terms.html"
  },
  "name": {
    "short": "Mic Check",
    "full": "Mic Check — Can U Hear Me Now"
  },
  "description": {
    "short": "Confirm your mic is being heard before you speak up.",
    "full": "Mic Check adds an in-meeting panel that confirms your microphone is producing audio — so you never have to open with \"can you hear me?\" again. Run a two-second local check and see a live level meter plus a clear \"you're being heard\" verdict. Audio is analyzed entirely on your device; nothing is recorded or uploaded."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#5B5FC7",
  "staticTabs": [
    {
      "entityId": "mic-check-personal",
      "name": "Mic Check",
      "contentUrl": "{{CONTENT_BASE}}/index.html",
      "websiteUrl": "{{CONTENT_BASE}}/index.html",
      "scopes": ["personal"]
    }
  ],
  "configurableTabs": [
    {
      "configurationUrl": "{{CONTENT_BASE}}/config.html",
      "canUpdateConfiguration": false,
      "scopes": ["groupChat"],
      "context": ["meetingSidePanel", "meetingChatTab", "meetingDetailsTab"]
    }
  ],
  "validDomains": ["{{VALID_DOMAIN}}"],
  "devicePermissions": ["media"]
}
